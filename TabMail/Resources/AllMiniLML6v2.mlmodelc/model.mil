            tensor<fp16, [1, 1]> reduce_sum_0_cast_fp16 = reduce_sum(axes = var_530, keep_dims = var_531, x = pow_0_cast_fp16)[name = tensor<string, []>("reduce_sum_0_cast_fp16")];
            tensor<fp16, []> var_533_y_0_to_fp16 = const()[name = tensor<string, []>("op_533_y_0_to_fp16"), val = tensor<fp16, []>(0x1p-1)];
            tensor<fp16, [1, 1]> var_533_cast_fp16 = pow(x = reduce_sum_0_cast_fp16, y = var_533_y_0_to_fp16)[name = tensor<string, []>("op_533_cast_fp16")];
            tensor<fp16, []> var_534_to_fp16 = const()[name = tensor<string, []>("op_534_to_fp16"), val = tensor<fp16, []>(0x1p-24)];
            tensor<fp16, [1, 1]> var_535_cast_fp16 = maximum(x = var_533_cast_fp16, y = var_534_to_fp16)[name = tensor<string, []>("op_535_cast_fp16")];
            tensor<int32, [2]> denom_reps_0 = const()[name = tensor<string, []>("denom_reps_0"), val = tensor<int32, [2]>([1, 384])];
            tensor<fp16, [1, 384]> denom_cast_fp16 = tile(reps = denom_reps_0, x = var_535_cast_fp16)[name = tensor<string, []>("denom_cast_fp16")];
            tensor<fp16, [1, 384]> sentence_embedding = real_div(x = input_cast_fp16, y = denom_cast_fp16)[name = tensor<string, []>("op_537_cast_fp16")];
        } -> (sentence_embedding);
}