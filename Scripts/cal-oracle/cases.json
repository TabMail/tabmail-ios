    {
      "id": "rfc-examples/daily-count-10",
      "family": "rfc-examples",
      "why": "RFC 5545's 'Daily for 10 occurrences'.",
      "references": [
        "RFC 5545 §3.8.5.3"
      ],
      "zones": [
        "America/New_York"
      ],
      "master": [
        "DTSTART;TZID=America/New_York:19970902T090000",
        "DTEND;TZID=America/New_York:19970902T100000",
        "RRULE:FREQ=DAILY;COUNT=10"
      ],
      "window": {
        "from": "1997-09-01T00:00:00Z",
        "to": "1997-09-15T00:00:00Z"
      },
      "frame": "zoned:America/New_York",
      "expect": "occurrences",
      "ruleDays": true,
      "rfc": {
        "days": [
          "1997-09-02..1997-09-11"
        ],
        "wall": "09:00:00"
      }
    },
