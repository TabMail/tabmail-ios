// Secrets.xcconfig.example — copy to Secrets.xcconfig and fill in your values.
//
// TabMail reads these at build time (see project.yml -> configFiles) and injects
// them into Info.plist via $(VAR) substitution. Secrets.xcconfig itself is
// gitignored; only this template is committed.
//
// If you fork TabMail to run against your own backend, set these to your own
// OAuth client IDs and freshly generated keys.

// Apple Developer Team ID — used for code signing (CODE_SIGN_STYLE = Automatic).
//   Find it at https://developer.apple.com/account -> Membership (a 10-char ID),
//   or in Xcode -> Settings -> Accounts -> your team. Required for device and
//   Release/archive builds; simulator + unit-test builds can sign ad-hoc without it.
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// Google OAuth — iOS Client ID
//   1. https://console.cloud.google.com/apis/credentials
//   2. Create an OAuth 2.0 Client ID (type: iOS)
//   3. Set the bundle ID (default: ai.tabmail.ios)
//   4. Copy the Client ID below
//   5. The redirect scheme is the reversed client ID (com.googleusercontent.apps.XXXX)
GOOGLE_CLIENT_ID = your-client-id.apps.googleusercontent.com
GOOGLE_REDIRECT_SCHEME = com.googleusercontent.apps.your-client-id

// Microsoft Azure — iOS Client ID
//   1. https://portal.azure.com -> App registrations
//   2. Create a registration (type: Mobile and desktop applications)
//   3. Add redirect URI: msauth.ai.tabmail.ios://auth
//   4. Copy the Application (client) ID below
MICROSOFT_CLIENT_ID = your-azure-app-client-id
MICROSOFT_REDIRECT_SCHEME = msauth.ai.tabmail.ios

// Demo Mode client secret — sent as the X-Demo-Client-Secret header on
// POST /demo/start to gate anonymous demo-account creation. It must match the
// value the backend expects.
//
// NOTE: this value ships inside the app binary and can be extracted by anyone
// who downloads it. It is a defense-in-depth friction layer, NOT a
// cryptographic guarantee — the server-side spend circuit breaker is the real cap.
//
// Generate with: openssl rand -hex 32
DEMO_CLIENT_SECRET = demo-client-secret-hex-32-bytes

// IMAP credential encryption key — symmetric AES-256, base64-encoded raw bytes.
//
// For generic IMAP accounts (not Gmail/Outlook), the notification service
// encrypts the IMAP credential payload with this key before sending it to the
// push service; the IMAP IDLE proxy decrypts it just before logging in. This
// adds app-layer protection on top of TLS, so a slip in any intermediate log
// leaks only ciphertext. Must match the value configured on the proxy.
//
// One key per environment; the app selects at runtime based on the backend the
// build targets. Generate each with: openssl rand -base64 32
IMAP_CRED_ENCRYPTION_KEY_DEV = base64-32-bytes-for-dev
IMAP_CRED_ENCRYPTION_KEY_PROD = base64-32-bytes-for-prod
